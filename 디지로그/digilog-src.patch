@@ -0,0 +1,122 @@
+/**
+ * 디지로그: 포케로그 종 데이터 위에 디지몬 188종(디지골드 자료)을 덮어쓴다.
+ * - 디지몬이 들어간 종 칸: 능력치·타입·특성·레벨 기술·진화·시작 비용·알 등급을 디지몬 것으로
+ * - 나머지 포켓몬 칸: 시작·알 목록에서 빠지고 진화도 끊는다(적으로 나오면 {@linkcode digimonize} 로 디지몬이 대신 나온다)
+ */
+import { DIGIMON_RECORDS, type DigimonRecord } from "#balance/digimon-data";
+import { EvolutionItem, SpeciesEvolution } from "#balance/pokemon-evolutions";
+import { GrowthRate } from "#data/exp";
+import type { PokemonSpecies } from "#data/pokemon-species";
+import { EggTier } from "#enums/egg-type";
+import type { AbilityId } from "#enums/ability-id";
+import type { MoveId } from "#enums/move-id";
+import type { PokemonType } from "#enums/pokemon-type";
+import type { SpeciesId } from "#enums/species-id";
+import type { SpeciesDataMap } from "#types/pokemon-species";
+import type { StarterCost } from "#balance/starters";
+
+export const DIGIMON_IDS: ReadonlySet<number> = new Set(DIGIMON_RECORDS.map(r => r.id));
+const BY_ID = new Map<number, DigimonRecord>(DIGIMON_RECORDS.map(r => [r.id, r]));
+
+export function isDigimon(speciesId: number): boolean {
+  return DIGIMON_IDS.has(speciesId);
+}
+
+function makeEvolution(e: DigimonRecord["evos"][number]): SpeciesEvolution {
+  if (e.item) {
+    return new SpeciesEvolution({
+      speciesId: e.to as SpeciesId,
+      level: e.level ?? 1,
+      item: EvolutionItem[e.item as keyof typeof EvolutionItem],
+    });
+  }
+  return new SpeciesEvolution({ speciesId: e.to as SpeciesId, level: e.level ?? 1 });
+}
+
+/** 종 데이터 표에 디지몬을 덮어쓴다(SpeciesDataRegistry 생성자에서 한 번 호출). */
+export function applyDigimon(data: SpeciesDataMap): void {
+  for (const key of Object.keys(data)) {
+    const id = Number(key);
+    const entry = data[id as SpeciesId];
+    if (!entry || isDigimon(id)) {
+      continue;
+    }
+    delete entry.starterCost;
+    delete entry.eggTier;
+    entry.evolutions = [];
+  }
+  for (const r of DIGIMON_RECORDS) {
+    const entry = data[r.id as SpeciesId];
+    if (!entry) {
+      continue;
+    }
+    const sp = entry.species as unknown as Record<string, unknown> & PokemonSpecies;
+    const w = sp as unknown as Record<string, unknown>;
+    w.type1 = r.type1 as PokemonType;
+    w.type2 = r.type2 === null ? null : (r.type2 as PokemonType);
+    w.ability1 = r.ability1 as AbilityId;
+    w.ability2 = r.ability2 as AbilityId;
+    w.abilityHidden = 0 as AbilityId;
+    w.baseStats = [...r.stats];
+    w.baseTotal = r.bst;
+    w.catchRate = r.catch;
+    w.baseExp = r.exp;
+    w.growthRate = GrowthRate[r.growth as keyof typeof GrowthRate];
+    w.malePercent = r.male;
+    w.genderDiffs = false;
+    w.forms = [];
+    w.legendary = r.legendary;
+    w.subLegendary = false;
+    w.mythical = false;
+    w.canChangeForm = false;
+    entry.levelMoves = r.levelMoves.map(([lv, mv]) => [lv, mv as MoveId]);
+    entry.tms = [];
+    delete entry.formLevelMoves;
+    delete entry.formTms;
+    delete entry.formChanges;
+    entry.evolutions = r.evos.map(makeEvolution);
+    entry.starter = r.starter as never;
+    entry.prevolution = null;
+    entry.passives = r.ability2 as AbilityId;
+    if (r.cost === null) {
+      delete entry.starterCost;
+    } else {
+      entry.starterCost = r.cost as StarterCost;
+    }
+    if (r.eggTier === null) {
+      delete entry.eggTier;
+    } else {
+      entry.eggTier = EggTier[r.eggTier as keyof typeof EggTier];
+    }
+  }
+}
+
+const STAGE_BY_LEVEL: [number, string][] = [
+  [14, "성장기"],
+  [30, "성숙기"],
+  [46, "완전체"],
+  [Number.POSITIVE_INFINITY, "궁극체"],
+];
+
+/**
+ * 디지몬이 아닌 종이 적으로 나오려 할 때 같은 무게의 디지몬으로 바꾼다.
+ * 레벨에 맞는 단계 중 종족값 합이 가장 가까운 몇 종에서, 원래 종 번호로 하나를 정한다(같은 자리엔 늘 같은 디지몬).
+ */
+export function digimonize(species: PokemonSpecies, level: number, lookup: (id: SpeciesId) => PokemonSpecies): PokemonSpecies {
+  if (isDigimon(species.speciesId)) {
+    return species;
+  }
+  const stage = STAGE_BY_LEVEL.find(([lv]) => level < lv)![1];
+  let pool = DIGIMON_RECORDS.filter(r => r.stage === stage);
+  if (pool.length === 0) {
+    pool = DIGIMON_RECORDS;
+  }
+  const bst = species.baseTotal;
+  const near = [...pool].sort((a, b) => Math.abs(a.bst - bst) - Math.abs(b.bst - bst)).slice(0, 8);
+  const pick = near[(species.speciesId * 2654435761) % near.length];
+  return lookup(pick.id as SpeciesId);
+}
+
+export function getDigimonRecord(speciesId: number): DigimonRecord | undefined {
+  return BY_ID.get(speciesId);
+}
